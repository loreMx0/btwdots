* {
    base:     #1e1e2e;
    surface0: #313244;
    text:     #cdd6f4;
    subtext0: #a6adc8;
    mauve:    #cba6f7;
    pink:     #f5c2e7;

    background-color: transparent;
    text-color: @text;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @base;
    border: 1px;
    border-color: @mauve;
    width: 480px;
    padding: 12px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @surface0;
    text-color: @text;
    padding: 8px 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @pink;
    padding: 0 8px 0 0;
}

listview {
    layout: vertical;
    lines: 8;
    spacing: 2px;
    scrollbar: false;
}

element {
    padding: 8px 10px;
}

element normal.normal {
    background-color: transparent;
    text-color: @text;
}

element selected.normal {
    background-color: @surface0;
    text-color: @mauve;
    border: 0px 0px 0px 2px;
    border-color: @mauve;
}
