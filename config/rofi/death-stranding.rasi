* {
    base:    #1f2320;
    surface: #2c322e;
    text:    #dce4e2;
    subtext: #a9b8ba;
    accent:  #d97a2f;
    border:  #5a6b73;

    background-color: transparent;
    text-color: @text;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @base;
    border: 1px;
    border-color: @border;
    width: 480px;
    padding: 12px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @surface;
    text-color: @text;
    padding: 8px 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    padding: 0 8px 0 0;
}

listview {
    layout: vertical;
    lines: 8;
    spacing: 2px;
    scrollbar: false;
}

element {
    padding: 8px 10px;
}

element normal.normal {
    background-color: transparent;
    text-color: @text;
}

element selected.normal {
    background-color: @surface;
    text-color: @accent;
    border: 0px 0px 0px 2px;
    border-color: @accent;
}
