* {
    bg:       #2b3a52ee;
    bg-alt:   #3d5470;
    fg:       #f0e6cf;
    accent:   #7fb3ad;
    pink:     #e2a6bb;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrains Mono 11";
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
    width: 500px;
    padding: 12px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @bg-alt;
    text-color: @fg;
    border-radius: 6px;
    padding: 8px 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @pink;
    padding: 0 8px 0 0;
}

entry {
    placeholder: "Run...";
}

listview {
    layout: vertical;
    lines: 8;
    spacing: 2px;
    fixed-height: false;
    scrollbar: false;
}

element {
    padding: 6px 10px;
    border-radius: 6px;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent;
    text-color: @bg;
}

element-icon {
    size: 20px;
}

element-text {
    padding: 0 0 0 8px;
}
